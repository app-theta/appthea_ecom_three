# API base — Laravel app URL only, no /api and no trailing slash (client.js appends /api itself)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Business public key — goes in the apptheta_public-key header on every request
NEXT_PUBLIC_APPTHETA_PUBLIC_KEY=pk_apptheta-sONVDBmKsVByYwnkQ2Xa3h6wZj92bGzx

# This store's public address, no trailing slash - canonical URLs, sitemap and share
# previews are built from it. On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: lets the backend refresh cached pages at once after an edit
# (POST /api/revalidate with header x-revalidate-secret). Leave empty to disable.
REVALIDATE_SECRET=
